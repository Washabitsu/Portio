{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "Authority": "https://localhost:7256/",
    "ClientId": "portio-bff",
    "RedirectUri": "https://localhost:7287/bff/callback",
    "FrontendUrl": "https://localhost:7287",
    "PublicPaths": [ "/api/OIDC", "/api/auth/google/callback", "/api/v1/ml_jobs/jobs/predict/api-key" ]
  },

  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "projectio",
        "Match": { "Path": "/api/OIDC/{**rest}" },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "google-callback": {
        "ClusterId": "projectio",
        "Match": { "Path": "/api/auth/google/callback" },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "api-key": {
        "ClusterId": "orchestrml",
        "Match": { "Path": "/api/v1/ml_jobs/jobs/predict/api-key" }
      },
      "account": {
        "ClusterId": "projectio",
        "Match": { "Path": "/api/account/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "Cookie" }
        ]
      },
      "ml": {
        "ClusterId": "orchestrml",
        "Match": { "Path": "/api/ml/{**rest}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/ml" },
          { "PathPrefix": "/api/v1" },
          { "RequestHeaderRemove": "Cookie" }
        ]
      },
      "spa": {
        "ClusterId": "spa",
        "Match": { "Path": "/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "Cookie" }
        ]
      }
    },
    "Clusters": {
      "projectio": {
        "Destinations": {
          "main": { "Address": "https://localhost:7256/" }
        }
      },
      "orchestrml": {
        "Destinations": {
          "main": { "Address": "http://localhost:8000/" }
        }
      },
      "spa": {
        "Destinations": {
          "main": { "Address": "http://localhost:5173/" }
        }
      }
    }
  }
}
